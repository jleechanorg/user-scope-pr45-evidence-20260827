[0.234163, "o", "=== 3. SAFE CODE DIFFS ===\r\n"]
[0.236108, "o", "diff --git a/config/mcp-daemon/force-loopback.cjs b/config/mcp-daemon/force-loopback.cjs\r\nnew file mode 100644\r\nindex 000000000..0690b74c8\r\n--- /dev/null\r\n+++ b/config/mcp-daemon/force-loopback.cjs\r\n@@ -0,0 +1,15 @@\r\n+'use strict';\r\n+\r\n+// Supergateway 3.4.3 does not expose a host option and calls listen(port).\r\n+// Scope this preload to the gateway process so omitted hosts bind to loopback.\r\n+const net = require('node:net');\r\n+const originalListen = net.Server.prototype.listen;\r\n+\r\n+net.Server.prototype.listen = function forceLoopback(...args) {\r\n+  if (typeof args[0] === 'number' && (args.length === 1 || typeof args[1] === 'function')) {\r\n+    args.splice(1, 0, '127.0.0.1');\r\n+  } else if (args[0] && typeof args[0] === 'object' && !args[0].host) {\r\n+    args[0] = { ...args[0], host: '127.0.0.1' };\r\n+  }\r\n+  return originalListen.apply(this, args);\r\n+};\r\ndiff --git a/config/mcp-daemon/mcp-daemon.service.template b/config/mcp-daemon/mcp-daemon.service.template\r\nnew file mode 100644\r\nindex 000000000..1cc5fd5c3\r\n--- /dev/null\r\n+++ b/config/mcp-daemon/mcp-daemon.service.template\r\n@@ -0,0 +1,15 @@\r\n+[Unit]\r\n+Description=Shared MCP daemon\r\n+Wants=network-online.target\r\n+After=network-online.target\r\n+\r\n+[Service]\r\n+Type=simple\r\n+ExecStart=@CONFIG_DIR@/start-mcp-daemons.sh run\r\n+Restart=on-failure\r\n+RestartSec=3\r\n+KillMode=control-group\r\n+UMask=0077\r\n+\r\n+[Install]\r\n+WantedBy=default.target\r\n"]
[0.236344, "o", "=== 4. REMOTE BRANCH CONTAINMENT ===\r\n"]
